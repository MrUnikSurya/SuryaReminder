rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Scenario toggle (A/B). Client can read/write only this exact doc,
    // and only the fields it's supposed to contain.
    match /state/settings {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['scenario', 'updatedAt'])
                   && request.resource.data.scenario in ['A', 'B'];
    }

    // This device's FCM push token. Same idea — single fixed doc id,
    // shape-validated so it can't be used to store anything else.
    match /devices/main {
      allow read: if false; // token never needs to be read back by the client
      allow write: if request.resource.data.keys().hasOnly(['token', 'updatedAt'])
                   && request.resource.data.token is string
                   && request.resource.data.token.size() > 10;
    }

    // Custom reminders you add yourself in Settings. Client can read the
    // whole collection (needed to render them into the schedule) and
    // create/update/delete individual reminders, but each doc's shape is
    // validated so this can't be used to store arbitrary data.
    match /reminders/{reminderId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['label', 'time', 'repeat', 'days', 'date', 'createdAt'])
                   && request.resource.data.label is string
                   && request.resource.data.label.size() > 0
                   && request.resource.data.label.size() < 120
                   && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                   && request.resource.data.repeat in ['daily', 'weekly', 'once'];
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
